# URL of the running Ollama server
OLLAMA_HOST=http://localhost:11434

# Model used when a request does not include "model"
OLLAMA_MODEL=llama3.2:1b

# Maximum time in seconds to wait for Ollama
OLLAMA_TIMEOUT=120

# Comma-separated browser origins allowed to call the API during development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
